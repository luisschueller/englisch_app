rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /words/{id} {
      // Jedes Gerät darf die Vokabeln lesen (zum Spielen) ...
      allow read: if true;
      // ... aber nur der Eltern-Account darf sie ändern. E-Mail-Adresse hier eintragen.
      allow write: if request.auth != null && request.auth.token.email == "ELTERN-EMAIL-HIER-EINTRAGEN";
    }
  }
}
